<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="../scripts/findElements.js"></script>


<h1>Elden Ring Seed Finder</h1>


{{!-- form --}}
<form action="/find" method="post">

    {{!-- nightlord --}}
    <label for="curNightLord">Nightlord</label> <br>
    <select name="curNightLord" id="curNightLord">
        {{#each currentNightlord}}
            <option value="{{value}}">{{value}}</option>
        {{/each}}
    </select>
    <br><br>

    {{!-- shifting earth --}}
    <label for="shifting_earth_sel">Shifting Earth</label> <br>
    <select name="shifting_earth_sel" id="shifting_earth_sel">
        {{#each shifting_earth}}
            <option value="{{value}}">{{label}}</option>
        {{/each}}
    </select>
    <br><br>

    {{!-- first base --}}
    <label for="major1">Top Major Base</label> <br>
    <select name="major1" id="major1">
        {{#each majorBase}}
            <option value="{{value}}">{{label}}</option>
        {{/each}}    
    </select>
    <select name="elements1" id="elements1"></select>
    <br><br>
    
    {{!-- second base --}}
    <label for="major2">Bottom Major Base</label> <br>
    <select name="major2" id="major2">
        {{#each majorBase}}
            <option value="{{value}}">{{label}}</option>
        {{/each}}   
    </select>
    <select name="elements2" id="elements2"></select>
    <br><br>

    {{!-- small 1 --}}
    <label for="small1">Left Minor Base</label> <br>
    <select name="small1" id="small1">
        {{#each smallBase}}
            <option value="{{value}}">{{label}}</option>
        {{/each}}
    </select>
    <br><br>

    {{!-- small 2 --}}
    <label for="small2">Right Minor Base</label> <br>
    <select name="small2" id="small2">
        {{#each smallBase}}
            <option value="{{value}}">{{label}}</option>
        {{/each}}
    </select>
    <br><br>

    <button type="submit">find</button>

</form>


    <style>
    body {
        background-color: #121212;
        color: #e0e0e0;
        font-family: system-ui, sans-serif;
        margin: 0;
        padding: 20px;
    }

    h1 {
        color: #ffffff;
        margin-bottom: 24px;
    }

    label {
        color: #cccccc;
        font-weight: 500;
    }

    select, button {
        background-color: #1e1e1e;
        color: #e0e0e0;
        border: 1px solid #444;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 1rem;
        margin-top: 4px;
    }

    select:focus, button:focus {
        outline: none;
        border-color: #4aa3ff;
    }

    button {
        background-color: #2a2a2a;
        cursor: pointer;
    }

    button:hover {
        background-color: #3a3a3a;
    }

    form {
        max-width: 600px;
    }

    br {
        line-height: 1.5;
    }
    </style>




