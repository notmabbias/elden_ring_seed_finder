  position: fixed;
  bottom: 12px;
  right: 12px;
  margin: 0;
  padding: 6px 12px;
  font-size: 1.2em;
  z-index: 1000;
  text-decoration: none;
  color: #e0e0e0;
}

.ringStart-label {
  position: fixed;
  top: 12px;
  right: 12px;
