<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="../scripts/timer.js"></script>

<!-- map -->

<div class="row">
  <div class="left">
    <img src="../seedMap/{{data.0.seed}}.jpg" alt="no seed img found" width="940" height="940">
  </div>

<!-- list -->

<div class="right">
  <div class="scroll-zone">
    <h2>Extra Data</h2>
    <ul>
      {{#each extraData}}
        <li><strong>Night 1 Boss: </strong>{{this.boss1}}</li>
        <li><strong>Night 2 Boss: </strong>{{this.boss2}}</li><br>
        <li><strong>Top Castle Boss: </strong>{{this.top_castle}}</li>
        <li><strong>Bottom Castle Boss: </strong>{{this.bottom_castle}}</li>
        <li><strong>Castle Enemy: </strong>{{this.castle_enemy}}</li><br>
        {{#hideFalse this.event}}<li><strong>Event: </strong>{{this.event}}</li>{{/hideFalse}}
        {{#hideFalse this.extra_boss}}<li><strong>Extra Boss: </strong>{{this.extra_boss}}</li>{{/hideFalse}}
      {{/each}}

    </ul>
  </div>

  <h1 class="ringStart-label" id="ringStart">Ring 1 Starts In: 4:25</h1>
  <h1 class="ringClose-label" id="ringClose"></h1>

  <div class="timerReset-label">
    <h3 id="timerReset"></h3>
  </div>

  <h2 class="bottom-label"><a href="/find" style="color:#e0e0e0">{{data.0.nightlord}} seed #{{data.0.seed}}</a></h2>

</div>




<style>  
