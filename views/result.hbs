}

.timerReset-label {
  position: fixed;
  top: 52px;
  right: 12px;
  margin: 0;
  padding: 6px 12px;
  font-size: 1.5em;
  z-index: 1000;
}




  .right ul {
    margin: 0;
    padding-left: 1.25rem;
    padding-top: 10px;
