<head>
  <link rel="stylesheet" href="css/result.css">
</head>
<h2>seed results</h2>

<!-- map -->

<div class="row">
  <div class="left">
    <img src="../seedMap/{{data.0.seed}}.jpg" alt="no seed ig" width="780" height="780">
  </div>

<!-- list -->

  <div class="right">
    <ul>
      {{#each extraData}}
      <li><strong>Event: </strong>{{this.event}}</li>
      <li><strong>Night 1 Boss: </strong>{{this.boss1}}</li>
      <li><strong>Night 2 Boss: </strong>{{this.boss2}}</li>
      <li><strong>Extra Boss: </strong>{{this.extra_boss}}</li><br>
      <li><strong>Top Castle Boss: </strong>{{this.top_castle}}</li>
      <li><strong>Bottom Castle Boss: </strong>{{this.bottom_castle}}</li>
      <li><strong>Castle Enemy: </strong>{{this.castle_enemy}}</li>
      {{/each}}
    </ul>
  </div>
  <a href="find">back</a>
</div>



<!-- table -->


<table>
  <thead>
    <tr>
      <th>seed</th><th>nightlord</th><th>shifting_earth</th><th>summonwater</th><th>mistwood</th><th>hawk</th><th>church</th>
    </tr>
  </thead>
  <tbody>
    {{#each data}}
      <tr>
        <td>{{this.seed}}</td>
        <td>{{this.nightlord}}{{#if this.s_nightlord}}{{this.s_nightlord}}{{/if}}</td>
        <td>{{this.shifting_earth}}{{#if this.s_shifting_earth}}{{this.s_shifting_earth}}{{/if}}</td>
        <td>{{this.summonwater_base}} / {{this.summonwater_element}}{{#if this.s_summonwater_base}}{{this.s_summonwater_base}} / {{this.s_summonwater_element}}{{/if}}</td>
        <td>{{this.mistwood_base}} / {{this.mistwood_element}}</td>
        <td>{{this.hawk_small_base}}</td>
        <td>{{this.church_small_base}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<style>
    table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1em;
    font-family: sans-serif;
    font-size: 0.95em;
  }

  thead {
    background-color: #f2f2f2;
  }

  th, td {
    border: 1px solid #ccc;
    padding: 8px 12px;
    text-align: left;
  }

  tbody tr:nth-child(even) {
    background-color: #fafafa;
  }

  tbody tr:hover {
    background-color: #eef;
  }
  
  .row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .left {
    flex: 0 0 780px;
    width: 780px;
    height: 780px;
  }

  .left img {
    width: 780px;
    height: 780px;
    display: block;
    object-fit: cover;
  }

  .right {
    flex: 1 1 0;
    min-width: 280px;
    max-height: 780px;
    overflow: auto;
  }

  .right ul {
    margin: 0;
    padding-left: 1.25rem;
    padding-top: 10px;
    line-height: 1.5;
  }

  @media (max-width: 920px) {
    .row {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
  }

  @media (max-width: 520px) {
    .row { flex-direction: column; align-items: center; }
    .left { width: 780px; height: 780px; }
    .left img { width: 780px; height: 780px; }
    .right { max-width: 90vw; max-height: none; overflow: visible; }
  }

    /* Dark mode overrides */
  body {
    background-color: #121212;
    color: #e0e0e0;
  }

  h2 {
    color: #ffffff;
  }

  a {
    color: #4aa3ff;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  /* Table dark styling */
  table {
    background-color: #1e1e1e;
    color: #e0e0e0;
  }

  thead {
    background-color: #2a2a2a;
  }

  th, td {
    border: 1px solid #444;
  }

  tbody tr:nth-child(even) {
    background-color: #1a1a1a;
  }

  tbody tr:hover {
    background-color: #2c2c2c;
  }

  /* Right panel list */
  .right ul {
    color: #ccc;
  }
  .right li strong {
    color: #fff;
  }


</style>
